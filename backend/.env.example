# Copy this file to .env on the shop PC that is physically on the same
# network as the thermal receipt printer and the label printer.

# Your deployed backend URL (Render/Railway), e.g. https://el-resala-api.onrender.com
BACKEND_URL=https://your-backend.onrender.com

# Must match AGENT_API_KEY in the backend's .env exactly.
AGENT_API_KEY=replace_this_with_the_same_value_as_the_backend

# How often (ms) to check the backend for new print jobs.
POLL_INTERVAL_MS=3000

# Thermal receipt printer (sales receipts, repair intake, shift Z-reports)
RECEIPT_PRINTER_IP=192.168.1.50
RECEIPT_PRINTER_PORT=9100

# TSPL barcode label printer (IMEI tags, repair ticket stickers)
LABEL_PRINTER_IP=192.168.1.52
LABEL_PRINTER_PORT=9100
